rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can read and write their own team
    match /teams/{teamId} {
      allow read, write: if request.auth != null && 
        (resource.data.managerId == request.auth.uid || 
         request.data.managerId == request.auth.uid);
    }
    
    // Anyone can read tournaments (for viewing)
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if false; // Only server-side functions should create tournaments
    }
    
    // Anyone can read matches
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow write: if false; // Only server-side functions should create matches
    }
    
    // Leaderboard data is read-only for clients
    match /leaderboard/{entry} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Training sessions belong to the user
    match /trainingSessions/{sessionId} {
      allow read, write: if request.auth != null;
    }
    
    // Referrals
    match /referrals/{referralId} {
      allow read: if request.auth != null && 
        (resource.data.referrerId == request.auth.uid || 
         resource.data.refereeId == request.auth.uid);
      allow create: if request.auth != null && 
        request.data.refereeId == request.auth.uid;
    }
  }
}